<%- include('../partials/header') %>
<section class="container page-fill" id="ubicacionesModule">
  <h2 class="dashboard-title">Mantenimiento - Ubicaciones</h2>

  <div class="card card--stretch">
    <!-- CABECERA DEL LISTADO -->
    <div class="card__head">
      <h3 class="card__title">Catálogo de Ubicaciones</h3>
    </div>

    <div class="usr-stack" style="padding: var(--s3);">
      <!-- LISTA (SCROLL INTERNO) -->
      <div class="table-clip" style="border: 1px solid var(--border-200); border-radius: 12px; max-height: 250px;">
        <table class="table table--grid" id="ubicacionesTable">
          <thead>
            <tr>
              <th style="width: 80px;">Código</th>
              <th style="width: 150px;">Ubicación</th>
              <th>Descripción</th>
              <th style="width: 100px; text-align: center;">Trabajo</th>
              <th style="width: 100px; text-align: center;">Ubic.</th>
              <th style="width: 120px;">Unidad</th>
              <th style="width: 80px; text-align: center;">Estado</th>
            </tr>
          </thead>
          <tbody id="ubi-tbody">
            <tr class="row-empty"><td colspan="7">Cargando ubicaciones...</td></tr>
          </tbody>
        </table>
      </div>

      <!-- FORMULARIO + BOTONERA LATERAL -->
      <div class="form-row" style="border-top: 1px solid var(--border-200); padding-top: var(--s3); margin-top: var(--s2);">
        <form id="ubicacionForm" class="form-body" novalidate style="display: flex; flex-direction: column; gap: var(--s3);">
          <div class="form-grid-2-local">
            <!-- Código auto-generado -->
            <div class="field" id="f-ubicod-container">
              <label for="f-ubicod">Código de Ubicación</label>
              <input type="text" id="f-ubicod" name="ubicod" class="input" readonly style="font-weight: bold; background: var(--surface-100);" placeholder="Cargando..." />
            </div>
            
            <div class="field" id="f-ubinom-container">
              <label for="f-ubinom">Nombre de Ubicación *</label>
              <input type="text" id="f-ubinom" name="ubinom" class="input" placeholder="Ej. Cuchilla" required maxlength="100" />
            </div>
          </div>

          <div class="field">
            <label for="f-ubides">Descripción de la Ubicación</label>
            <input type="text" id="f-ubides" name="ubides" class="input" placeholder="Ej. Ubicación de Destajo No Universal" maxlength="250" />
          </div>

          <div class="form-grid-2-local">
            <!-- TIPO DE TRABAJO -->
            <div class="field">
              <label for="f-tiptra">Tipo de Trabajo *</label>
              <select id="f-tiptra" name="tiptra" class="input" required>
                <option value="">SELECCIONE TIPO</option>
                <option value="D">DESTAJO (D)</option>
                <option value="J">JORNAL (J)</option>
              </select>
            </div>
            
            <!-- UNIDAD ASOCIADA -->
            <div class="field">
              <label for="f-unicod">Unidad de Medida *</label>
              <select id="f-unicod" name="unicod" class="input" required>
                <option value="">SELECCIONE UNIDAD</option>
              </select>
            </div>
          </div>

          <div style="display: flex; flex-direction: column; gap: var(--s2); margin-top: var(--s1);">
            <div class="field" style="display: flex; align-items: center; justify-content: space-between; gap: var(--s2); background: var(--surface-50); border: 1px solid var(--border-200); border-radius: 12px; padding: 12px 16px;">
              <label for="f-ubiuni" style="font-weight: 500; font-size: 0.9rem; color: var(--text-primary); margin-bottom: 0; cursor: pointer;">¿Es Ubicación Universal?</label>
              <input type="checkbox" id="f-ubiuni" name="ubiuni" class="switch" />
            </div>
            <div class="field" style="display: flex; align-items: center; justify-content: space-between; gap: var(--s2); background: var(--surface-50); border: 1px solid var(--border-200); border-radius: 12px; padding: 12px 16px;">
              <label for="f-ubistd" style="font-weight: 500; font-size: 0.9rem; color: var(--text-primary); margin-bottom: 0; cursor: pointer;">¿Estado Activo?</label>
              <input type="checkbox" id="f-ubistd" name="ubistd" class="switch" checked />
            </div>
            <div class="field" style="display: flex; align-items: center; justify-content: space-between; gap: var(--s2); background: var(--surface-50); border: 1px solid var(--border-200); border-radius: 12px; padding: 12px 16px;">
              <label for="f-ubidef" style="font-weight: 500; font-size: 0.9rem; color: var(--text-primary); margin-bottom: 0; cursor: pointer;">¿Por Defecto?</label>
              <input type="checkbox" id="f-ubidef" name="ubidef" class="switch" />
            </div>
          </div>
          
          <!-- Area de mensajes del formulario -->
          <div class="form-message-area" id="ubi-msg-area" style="margin-top: 12px;"></div>
        </form>

        <!-- BOTONES AL LADO (VERTICAL) -->
        <aside class="actions-side">
          <button type="button" class="btn btn-soft" id="btn-new">NUEVO</button>
          <button type="button" class="btn btn--brand" id="btn-save">GRABAR</button>
          <button type="button" class="btn btn-warning" id="btn-anular" style="display: none;">ANULAR</button>
          <button type="button" class="btn btn-danger" id="btn-delete" style="display: none;">BORRAR</button>
          <button type="button" class="btn btn-ghost" id="btn-cancel">CERRAR</button>
        </aside>
      </div>
    </div>
  </div>
</section>

<!-- Rejilla local de 2 columnas sin min-width restrictivo en celdas -->
<style>
.form-grid-2-local {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  min-width: 0;
  width: 100%;
}
.form-grid-2-local .field {
  margin-bottom: 0;
  min-width: 0;
}
@media (max-width: 480px) {
  .form-grid-2-local {
    grid-template-columns: 1fr;
    gap: var(--s2);
  }
}
.form-message-area.success {
  background-color: #eff6ff;
  border: 1px solid var(--brand-300);
  color: var(--brand-700);
}
.form-message-area.error {
  background-color: #fef2f2;
  border: 1px solid #fca5a5;
  color: #b91c1c;
}
</style>

<%- include('../partials/footer') %>
