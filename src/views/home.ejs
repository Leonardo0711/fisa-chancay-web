<%- include('partials/header') %>
<div class="container" style="padding-top: var(--s3); padding-bottom: var(--s4);">

  <!-- Hero -->
  <div class="card animate-in" style="padding: var(--s4); margin-bottom: var(--s3); background: linear-gradient(135deg, var(--brand-900) 0%, var(--brand-700) 100%); color: #fff; border: none;">
    <h1 style="margin: 0 0 var(--s-1); font-size: clamp(1.4rem, 2.5vw, 2rem); font-weight: 800; color: #fff;">
      Bienvenido, <%= user.usunom %>
    </h1>
    <p style="margin: 0; opacity: .85; font-size: .95rem;">Plataforma Industrial FISA S.A. — Panel de Administración</p>
  </div>

  <!-- Grid principal -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--s2); margin-bottom: var(--s3);">

    <!-- Contexto activo -->
    <div class="card animate-in" style="padding: var(--s3);">
      <h3 style="margin: 0 0 var(--s2); font-size: 1.05rem; font-weight: 800; color: var(--brand-900);">Contexto Activo</h3>
      <div style="display: grid; gap: var(--s1);">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--s-1) 0; border-bottom: 1px dashed var(--border);">
          <span style="color: var(--muted); font-weight: 600; font-size: .875rem;">Empresa</span>
          <span style="font-weight: 800; color: var(--brand-900);" id="currentEmpCod"><%= user.empcod || '—' %></span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--s-1) 0; border-bottom: 1px dashed var(--border);">
          <span style="color: var(--muted); font-weight: 600; font-size: .875rem;">Taller</span>
          <span style="font-weight: 800; color: var(--brand-900);" id="currentTalCod"><%= user.talcod || '—' %></span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--s-1) 0;">
          <span style="color: var(--muted); font-weight: 600; font-size: .875rem;">Rol</span>
          <span style="font-weight: 800; color: <%= user.usuadm ? 'var(--warn)' : 'var(--brand-700)' %>;">
            <%= user.usuadm ? 'Admin del Sistema' : 'Usuario Planta' %>
          </span>
        </div>
      </div>
      <div style="margin-top: var(--s2);">
        <button id="checkDbStatusBtn" class="btn btn--ghost" style="width: 100%; font-size: .85rem;">Verificar Conexión BD</button>
      </div>
    </div>

    <!-- Accesos Rápidos: Módulos -->
    <div class="card animate-in" style="padding: var(--s3);">
      <h3 style="margin: 0 0 var(--s2); font-size: 1.05rem; font-weight: 800; color: var(--brand-900);">Módulos</h3>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--s1);">

        <% if (user.usuadm || (user.permisos && user.permisos['USUARIOS'] && user.permisos['USUARIOS'].flgcon)) { %>
          <a href="<%= baseUrl %>usuarios" class="quick-module-card">
            <span class="qm-label">Usuarios</span>
          </a>
        <% } %>

        <% if (user.usuadm || (user.permisos && user.permisos['PROGRAMAS'] && user.permisos['PROGRAMAS'].flgcon)) { %>
          <a href="<%= baseUrl %>programas" class="quick-module-card">
            <span class="qm-label">Programas</span>
          </a>
        <% } %>

        <% if (user.usuadm || (user.permisos && user.permisos['PERFILES'] && user.permisos['PERFILES'].flgcon)) { %>
          <a href="<%= baseUrl %>perfiles" class="quick-module-card">
            <span class="qm-label">Perfiles</span>
          </a>
        <% } %>

        <% if (user.usuadm || (user.permisos && user.permisos['PRODUCCION'] && user.permisos['PRODUCCION'].flgcon)) { %>
          <a href="<%= baseUrl %>produccion" class="quick-module-card">
            <span class="qm-label">Producción</span>
          </a>
        <% } %>

      </div>
    </div>

  </div>

  <!-- Sección Monitor de Control de Producción -->
  <div class="card animate-in" style="padding: var(--s3); margin-top: var(--s2); border: 1px solid var(--border-color, #e2e8f0); box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
    
    <!-- Encabezado de Sección -->
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s2); margin-bottom: var(--s2); border-bottom: 1px solid var(--border-color, #e2e8f0); padding-bottom: var(--s2);">
      <div>
        <h2 style="margin: 0 0 4px 0; font-size: 1.15rem; font-weight: 800; color: var(--brand-900); text-transform: uppercase; letter-spacing: 0.5px;">
          Control de Producción &mdash; Registros Recientes
        </h2>
        <p style="margin: 0; color: var(--muted); font-size: 0.85rem;">
          Monitoreo de ingresos registrados. Haga clic en una fila o en el botón para ver el detalle de operarios.
        </p>
      </div>

      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px;">
        <button id="btnExportExcel" type="button" class="btn btn--brand" style="background: #107c41; border-color: #107c41; font-weight: 700; font-size: 0.85rem; padding: 7px 14px;">
          Exportar a Excel
        </button>
        <button id="btnRefreshRegs" type="button" class="btn btn-soft" style="font-weight: 700; font-size: 0.85rem; padding: 7px 14px;">
          Actualizar
        </button>
      </div>
    </div>

    <!-- Barra de Filtros y Búsqueda -->
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s2); margin-bottom: var(--s2);">
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px; flex: 1;">
        <div style="min-width: 260px; max-width: 380px; width: 100%;">
          <input type="text" id="regSearchInput" placeholder="BUSCAR POR OT, LOTE, UBICACIÓN O USUARIO..." class="input input--upper" style="width: 100%; height: 36px; font-size: 0.85rem;" />
        </div>

        <select id="regTypeFilter" class="input" style="width: 160px; height: 36px; font-size: 0.85rem;">
          <option value="">TODOS LOS TIPOS</option>
          <option value="D">DESTAJO (D)</option>
          <option value="J">JORNAL (J)</option>
        </select>
      </div>

      <div>
        <span id="regCountBadge" class="badge" style="background: var(--surface-100, #f1f5f9); color: var(--text-secondary, #475569); font-size: 0.8rem; padding: 5px 12px; border-radius: 4px; font-weight: 700; border: 1px solid var(--border-color, #e2e8f0);">
          Cargando registros...
        </span>
      </div>
    </div>

    <!-- Tabla Principal de Cabeceras -->
    <div class="table-clip" style="border: 1px solid var(--border-color, #e2e8f0); border-radius: 8px; overflow-x: auto; background: #fff;">
      <table class="table table--grid" style="width: 100%; font-size: 0.85rem;" id="tableProduccionHeaders">
        <thead>
          <tr>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: left;">N° CONTROL</th>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: left;">FECHA / HORA</th>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: left;">ORDEN TRABAJO</th>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: left;">LOTE</th>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: center;">TIPO</th>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: left;">UBICACIÓN</th>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: right;">CANTIDAD</th>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: right;">VU</th>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: center;">OPERARIOS</th>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: left;">USUARIO</th>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: center;">ACCIONES</th>
          </tr>
        </thead>
        <tbody id="tbodyProduccionHeaders">
          <tr class="row-empty">
            <td colspan="11" style="text-align: center; padding: 24px; color: var(--muted);">
              Cargando registros de producción...
            </td>
          </tr>
        </tbody>
      </table>
    </div>

  </div>

  <!-- MODAL FLOTANTE CENTRADO PARA EL DETALLE DE OPERARIOS -->
  <div class="modal" id="modalDetalle">
    <div class="modal-dialog" style="max-width: 820px; width: 90%;">
      <div class="modal-content">
        <div class="modal-header">
          <h3 id="modalDetalleTitle" style="margin: 0; font-size: 1.1rem; text-transform: uppercase;">Detalle de Registro</h3>
          <button type="button" class="modal-close" id="btnCloseModalDetalle">&times;</button>
        </div>
        <div class="modal-body" style="padding: 1.25rem;">
          
          <!-- Resumen de Cabecera en el Modal -->
          <div id="modalCabeceraResumen" style="background: var(--surface-50, #f8fafc); border: 1px solid var(--border-color, #e2e8f0); border-radius: 8px; padding: 12px 16px; margin-bottom: 16px; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px; font-size: 0.83rem;">
            <!-- Inyectado dinámicamente -->
          </div>

          <div style="font-weight: 800; color: var(--brand-900); margin-bottom: 8px; font-size: 0.88rem; text-transform: uppercase;">
            Operarios Asignados
          </div>

          <!-- Tabla de Operarios -->
          <div class="table-clip" style="border: 1px solid var(--border-color, #e2e8f0); border-radius: 8px; max-height: 320px; overflow-y: auto;">
            <table class="table table--grid" style="width: 100%; font-size: 0.85rem;" id="modalDetalleTable">
              <thead>
                <tr>
                  <th style="width: 45px; text-align: center; padding: 8px;">#</th>
                  <th style="width: 90px; text-align: left; padding: 8px;">CÓDIGO</th>
                  <th style="text-align: left; padding: 8px;">APELLIDOS Y NOMBRES</th>
                  <th style="width: 95px; text-align: center; padding: 8px;">CANT. (#)</th>
                  <th style="width: 95px; text-align: right; padding: 8px;">VU</th>
                  <th style="width: 105px; text-align: right; padding: 8px;">SUBTOTAL</th>
                </tr>
              </thead>
              <tbody id="modalDetalleTbody">
                <!-- Inyectado dinámicamente -->
              </tbody>
              <tfoot id="modalDetalleTfoot" style="font-weight: 800; background: var(--surface-100, #f1f5f9); border-top: 2px solid var(--border-color, #e2e8f0);">
                <!-- Totales inyectados dinámicamente -->
              </tfoot>
            </table>
          </div>

        </div>
        <div class="modal-footer" style="padding: 12px 1.5rem; border-top: 1px solid var(--border-color, #e2e8f0);">
          <button type="button" class="btn btn-soft" id="btnCerrarModalDetalle">Cerrar</button>
        </div>
      </div>
    </div>
  </div>

</div>
<%- include('partials/footer') %>
