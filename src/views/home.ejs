<%- include('partials/header') %>
<link rel="stylesheet" href="<%= baseUrl %>css/modules.css">
<style>
  /* Prevención de scroll global: el viewport se ajusta exactamente entre navbar y footer */
  html, body {
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden !important;
  }

  .app-shell {
    height: 100dvh;
    max-height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .main {
    height: calc(100dvh - var(--nav-h) - var(--footer-h)) !important;
    max-height: calc(100dvh - var(--nav-h) - var(--footer-h)) !important;
    overflow: hidden !important;
    display: flex !important;
    flex-direction: column !important;
    padding: 0 !important;
  }

  @supports not (height: 100dvh) {
    .app-shell {
      height: 100svh;
      max-height: 100svh;
    }
    .main {
      height: calc(100svh - var(--nav-h) - var(--footer-h)) !important;
      max-height: calc(100svh - var(--nav-h) - var(--footer-h)) !important;
    }
  }

  /* Contenedor principal de la vista: ocupa el 100% del alto disponible */
  .home-viewport-container {
    flex: 1 1 0;
    min-height: 0;
    height: 100%;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    padding: 10px clamp(12px, 2vw, 24px) 10px clamp(12px, 2vw, 24px);
    box-sizing: border-box;
    width: 100%;
    max-width: 1750px;
    margin: 0 auto;
  }

  /* Tarjeta contenedora adaptativa */
  .home-monitor-card {
    flex: 1 1 0;
    min-height: 0;
    height: 100%;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(15, 44, 77, 0.05);
    padding: 14px 18px 12px 18px;
    box-sizing: border-box;
    overflow: hidden;
    margin: 0;
  }

  /* Cabecera superior fija dentro de la tarjeta */
  .home-monitor-header {
    flex: 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--border-color, #e2e8f0);
    padding-bottom: 8px;
  }

  /* Barra de filtros fija */
  .home-monitor-filters {
    flex: 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  /* Contenedor con scroll interno adaptativo (vertical y horizontal) */
  .home-table-scroll {
    flex: 1 1 0;
    min-height: 0;
    height: 100%;
    overflow-y: auto !important;
    overflow-x: auto !important;
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 8px;
    background: #ffffff;
    position: relative;
    /* Scrollbars elegantes */
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 #f8fafc;
  }

  .home-table-scroll::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  .home-table-scroll::-webkit-scrollbar-track {
    background: #f8fafc;
    border-radius: 4px;
  }
  .home-table-scroll::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 4px;
  }
  .home-table-scroll::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
  }

  /* Encabezado pegajoso de la tabla (Sticky thead) */
  .home-table-scroll thead {
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .home-table-scroll thead th {
    position: sticky;
    top: 0;
    z-index: 10;
    background: #f8fafc !important;
    color: var(--brand-900, #0f2c4d);
    box-shadow: inset 0 -1px 0 var(--border-color, #e2e8f0);
    white-space: nowrap;
    user-select: none;
    font-size: 0.82rem;
    padding: 10px 10px;
  }

  #tableProduccionHeaders {
    width: 100%;
    min-width: 1400px;
    border-collapse: separate;
    border-spacing: 0;
  }

  #tbodyProduccionHeaders tr {
    transition: background-color 0.15s ease;
    cursor: pointer;
  }

  #tbodyProduccionHeaders tr:hover {
    background-color: #f8fafc !important;
  }

  /* Modales adaptativos: NUNCA se salen de la pantalla vertical ni horizontalmente */
  .modal {
    overflow-y: auto !important;
    padding: clamp(8px, 2vh, 20px) !important;
    box-sizing: border-box !important;
  }

  .modal-dialog {
    max-height: calc(100dvh - 32px) !important;
    display: flex !important;
    flex-direction: column !important;
    overflow: hidden !important;
    margin: auto !important;
    box-shadow: 0 25px 50px -12px rgba(15, 44, 77, 0.35) !important;
    border-radius: 12px !important;
    background: #ffffff !important;
    box-sizing: border-box !important;
  }

  @supports not (height: 100dvh) {
    .modal-dialog {
      max-height: calc(100svh - 32px) !important;
    }
  }

  .modal-content {
    display: flex !important;
    flex-direction: column !important;
    max-height: 100% !important;
    min-height: 0 !important;
    height: 100% !important;
    overflow: hidden !important;
    background: #ffffff !important;
  }

  .modal-header {
    flex: 0 0 auto !important;
    padding: 12px 18px !important;
    background: var(--surface-50, #f8fafc) !important;
    border-bottom: 1px solid var(--border-color, #e2e8f0) !important;
  }

  .modal-body {
    flex: 1 1 auto !important;
    min-height: 0 !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
    padding: 14px 18px !important;
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 #f8fafc;
    box-sizing: border-box !important;
  }

  .modal-body::-webkit-scrollbar {
    width: 6px;
  }
  .modal-body::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 3px;
  }

  .modal-footer {
    flex: 0 0 auto !important;
    padding: 10px 18px !important;
    background: var(--surface-50, #f8fafc) !important;
    border-top: 1px solid var(--border-color, #e2e8f0) !important;
  }

  .modal-summary-grid {
    background: var(--surface-50, #f8fafc);
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 8px;
    padding: 10px 14px;
    margin-bottom: 12px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 8px 12px;
    font-size: 0.81rem;
  }

  .modal-table-clip {
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 8px;
    max-height: 240px;
    min-height: 100px;
    overflow-y: auto !important;
    overflow-x: auto !important;
    background: #ffffff;
    scrollbar-width: thin;
  }

  .modal-table-clip thead th {
    position: sticky;
    top: 0;
    z-index: 5;
    background: #f8fafc !important;
    box-shadow: inset 0 -1px 0 var(--border-color, #e2e8f0);
  }
</style>

<div class="home-viewport-container">

  <!-- Sección Monitor de Control de Producción -->
  <div class="card home-monitor-card animate-in">
    
    <!-- Encabezado de Sección -->
    <div class="home-monitor-header">
      <div>
        <h2 style="margin: 0 0 4px 0; font-size: 1.15rem; font-weight: 800; color: var(--brand-900); text-transform: uppercase; letter-spacing: 0.5px;">
          Control de Producción &mdash; Registros Recientes
        </h2>
        <p style="margin: 0; color: var(--muted); font-size: 0.85rem;">
          Monitoreo de ingresos registrados. Haga clic en una fila o en el botón para ver el detalle de operarios.
        </p>
      </div>

      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px;">
        <button id="btnExportExcel" type="button" class="btn btn--brand" style="background: #107c41; border-color: #107c41; font-weight: 700; font-size: 0.85rem; padding: 7px 14px;">
          Exportar a Excel
        </button>
        <button id="btnRefreshRegs" type="button" class="btn btn-soft" style="font-weight: 700; font-size: 0.85rem; padding: 7px 14px;">
          Actualizar
        </button>
      </div>
    </div>

    <!-- Barra de Filtros y Búsqueda -->
    <div class="home-monitor-filters">
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px; flex: 1;">
        <div style="min-width: 260px; max-width: 380px; width: 100%;">
          <input type="text" id="regSearchInput" placeholder="BUSCAR POR OT, LOTE, UBICACIÓN O USUARIO..." class="input input--upper" style="width: 100%; height: 36px; font-size: 0.85rem;" />
        </div>

        <select id="regTypeFilter" class="input" style="width: 160px; height: 36px; font-size: 0.85rem;">
          <option value="">TODOS LOS TIPOS</option>
          <option value="D">DESTAJO (D)</option>
          <option value="J">JORNAL (J)</option>
        </select>
      </div>

      <div>
        <span id="regCountBadge" class="badge" style="background: var(--surface-100, #f1f5f9); color: var(--text-secondary, #475569); font-size: 0.8rem; padding: 5px 12px; border-radius: 4px; font-weight: 700; border: 1px solid var(--border-color, #e2e8f0);">
          Cargando registros...
        </span>
      </div>
    </div>

    <!-- Tabla Principal de Cabeceras con Scroll Interno -->
    <div class="table-clip home-table-scroll">
      <table class="table table--grid" style="width: 100%; font-size: 0.85rem;" id="tableProduccionHeaders">
        <thead>
          <tr>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: left;">N° CONTROL</th>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: left;">FECHA / HORA</th>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: left;">ORDEN TRABAJO</th>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: left;">LOTE</th>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: center;">TIPO</th>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: left;">UBICACIÓN</th>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: right;">CANTIDAD</th>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: right;">VU</th>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: right;">TARIFA</th>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: right;">S/</th>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: center;">OPERARIOS</th>
            <th style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: left;">USUARIO</th>
            <th class="col-actions" style="padding: 10px 10px; font-weight: 800; color: var(--brand-900); text-align: center; width: 280px; min-width: 280px; max-width: none !important;">ACCIONES</th>
          </tr>
        </thead>
        <tbody id="tbodyProduccionHeaders">
          <tr class="row-empty">
            <td colspan="13" style="text-align: center; padding: 24px; color: var(--muted);">
              Cargando registros de producción...
            </td>
          </tr>
        </tbody>
      </table>
    </div>

  </div> <!-- Closes .home-monitor-card -->

</div> <!-- Closes .home-viewport-container -->

  <!-- MODAL FLOTANTE CENTRADO PARA EL DETALLE DE OPERARIOS -->
  <div class="modal" id="modalDetalle">
    <div class="modal-dialog" style="max-width: 820px; width: 94%;">
      <div class="modal-content">
        <div class="modal-header">
          <h3 id="modalDetalleTitle" style="margin: 0; font-size: 1.1rem; text-transform: uppercase;">Detalle de Registro</h3>
          <button type="button" class="modal-close" id="btnCloseModalDetalle">&times;</button>
        </div>
        <div class="modal-body">
          
          <!-- Resumen de Cabecera en el Modal -->
          <div id="modalCabeceraResumen" class="modal-summary-grid">
            <!-- Inyectado dinámicamente -->
          </div>

          <div style="font-weight: 800; color: var(--brand-900); margin-bottom: 8px; font-size: 0.88rem; text-transform: uppercase;">
            Operarios Asignados
          </div>

          <!-- Tabla de Operarios con Cabecera Sticky y Scroll Interno -->
          <div class="table-clip modal-table-clip">
            <table class="table table--grid" style="width: 100%; font-size: 0.85rem;" id="modalDetalleTable">
              <thead>
                <tr>
                  <th style="width: 45px; text-align: center; padding: 8px;">#</th>
                  <th style="width: 90px; text-align: left; padding: 8px;">CÓDIGO</th>
                  <th style="text-align: left; padding: 8px;">APELLIDOS Y NOMBRES</th>
                  <th style="width: 95px; text-align: center; padding: 8px;" id="thModalDetalleCant">CANT. (#)</th>
                  <th style="width: 80px; text-align: right; padding: 8px;" id="thModalDetalleVu">VU</th>
                  <th style="width: 90px; text-align: right; padding: 8px;">TARIFA</th>
                  <th style="width: 105px; text-align: right; padding: 8px;">S/</th>
                </tr>
              </thead>
              <tbody id="modalDetalleTbody">
                <!-- Inyectado dinámicamente -->
              </tbody>
              <tfoot id="modalDetalleTfoot" style="font-weight: 800; background: var(--surface-100, #f1f5f9); border-top: 2px solid var(--border-color, #e2e8f0);">
                <!-- Totales inyectados dinámicamente -->
              </tfoot>
            </table>
          </div>

        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-soft" id="btnCerrarModalDetalle">Cerrar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL DE EDICIÓN DE REGISTRO DE PRODUCCIÓN -->
  <div class="modal" id="modalEditar">
    <div class="modal-dialog" style="max-width: 880px; width: 95%;">
      <div class="modal-content">
        <div class="modal-header">
          <div style="display: flex; align-items: center; gap: 8px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--brand-900)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
            <h3 id="modalEditarTitle" style="margin: 0; font-size: 1.1rem; text-transform: uppercase; color: var(--brand-900);">Editar Registro</h3>
          </div>
          <button type="button" class="modal-close" id="btnCloseModalEditar">&times;</button>
        </div>
        <div class="modal-body">
          
          <!-- Resumen de Cabecera en el Modal de Edición -->
          <div id="modalEditarResumen" class="modal-summary-grid">
            <!-- Inyectado dinámicamente -->
          </div>

          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <div style="font-weight: 800; color: var(--brand-900); font-size: 0.88rem; text-transform: uppercase;">
              Operarios Asignados (Valores Editables)
            </div>
            <div id="modalEditarBalanceBadge" class="badge" style="font-size: 0.8rem; font-weight: 800; background: var(--brand-50, #eff6ff); color: var(--brand-900); border: 1px solid var(--brand-200, #bfdbfe); padding: 4px 10px; border-radius: 6px;">
              <!-- Resumen dinámico -->
            </div>
          </div>

          <!-- Tabla de Operarios Editables con Cabecera Sticky y Scroll Interno -->
          <div class="table-clip modal-table-clip">
            <table class="table table--grid" style="width: 100%; font-size: 0.85rem;" id="modalEditarTable">
              <thead>
                <tr>
                  <th style="width: 45px; text-align: center; padding: 8px;">#</th>
                  <th style="width: 90px; text-align: left; padding: 8px;">CÓDIGO</th>
                  <th style="text-align: left; padding: 8px;">APELLIDOS Y NOMBRES</th>
                  <th style="width: 110px; text-align: center; padding: 8px;" id="thModalEditarCant">CANT. (#)</th>
                  <th style="width: 100px; text-align: right; padding: 8px;" id="thModalEditarVu">VU</th>
                  <th style="width: 90px; text-align: right; padding: 8px;">TARIFA</th>
                  <th style="width: 105px; text-align: right; padding: 8px;">S/</th>
                </tr>
              </thead>
              <tbody id="modalEditarTbody">
                <!-- Inyectado dinámicamente -->
              </tbody>
              <tfoot id="modalEditarTfoot" style="font-weight: 800; background: var(--surface-100, #f1f5f9); border-top: 2px solid var(--border-color, #e2e8f0);">
                <!-- Totales inyectados dinámicamente -->
              </tfoot>
            </table>
          </div>

          <div id="modalEditarAlert" class="status-alert" style="display: none; margin-top: 12px; padding: 10px; border-radius: 8px; font-weight: 700; font-size: 0.85rem; text-align: center;"></div>

        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-soft" id="btnCancelarModalEditar">Cancelar</button>
          <button type="button" class="btn btn--brand" id="btnGuardarModalEditar" style="min-width: 140px; font-weight: 800;">Guardar Cambios</button>
        </div>
      </div>
    </div>
  </div>
<%- include('partials/footer') %>
