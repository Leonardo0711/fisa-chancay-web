<%- include('partials/header') %>
<link rel="stylesheet" href="<%= baseUrl %>css/modules.css">
<section class="container page-fill" id="produccionModule">
  <h2 class="dashboard-title">Control de Producción</h2>

  <!-- PANEL SUPERIOR: SELECCIÓN Y DETALLES DE ORDEN DE TRABAJO -->
  <div class="card" style="box-shadow: var(--shadow-md); margin-bottom: var(--s3); background: var(--surface);">
    <div class="card__head" style="border-bottom: 1px solid var(--border-200); padding: 16px 24px;">
      <h3 class="card__title" style="font-size: 1.1rem; color: var(--brand-900);">Contexto de la Orden de Trabajo</h3>
    </div>
    <div class="card__body" style="padding: 24px; display: flex; flex-direction: column; gap: 20px;">
      <div class="ot-header-layout">
        <!-- Selector de OT -->
        <div class="field" style="margin-bottom: 0;">
          <label for="f-otcod" style="font-weight: 700; font-size: 0.8125rem; color: var(--brand-900); margin-bottom: 8px;">ORDEN DE TRABAJO *</label>
          <div style="display: flex; gap: var(--s2); align-items: center;">
            <input id="f-otcod" class="input input--upper" placeholder="HAGA CLIC PARA BUSCAR OT" readonly style="cursor: pointer; font-weight: 700; border-color: var(--brand-400);" required />
            <button type="button" id="btnBuscarOt" class="btn btn-soft" style="padding: 10px 14px; display: flex; align-items: center; justify-content: center; height: 44px; width: 44px; border-radius: 12px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </button>
          </div>
        </div>

        <!-- Info del Producto Horizontal -->
        <div class="info-block-horizontal">
          <div class="info-cell">
            <span class="info-cell-lbl">CÓDIGO PRODUCTO</span>
            <span class="info-cell-val" id="lbl-procod">---</span>
          </div>
          <div class="info-cell separator">
            <span class="info-cell-lbl">DESCRIPCIÓN DEL PRODUCTO</span>
            <span class="info-cell-val" id="lbl-pronom">---</span>
          </div>
          <div class="info-cell separator text-right">
            <span class="info-cell-lbl">CANTIDAD REQUERIDA</span>
            <span class="info-cell-val" id="lbl-canreq">---</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="produccion-grid">
    
    <!-- COLUMNA IZQUIERDA: PARÁMETROS -->
    <div class="card" style="box-shadow: var(--shadow-md);">
      <div class="card__head">
        <h3 class="card__title">Parámetros de Producción</h3>
      </div>
      <div class="card__body" style="padding: var(--s3); display: flex; flex-direction: column; gap: var(--s3);">
        <form id="produccionForm" autocomplete="off" novalidate style="display: flex; flex-direction: column; gap: var(--s3);">
          
          <!-- TIPO DE TRABAJO -->
          <div class="field">
            <label>TIPO DE TRABAJO</label>
            <div style="display: flex; gap: var(--s4); margin-top: 6px;">
              <label class="checkbox-container">
                <input type="radio" name="tiptra" id="f-tiptra-destajo" value="D" checked />
                <span class="checkmark" style="border-radius: 50%;"></span>
                DESTAJO
              </label>
              <label class="checkbox-container">
                <input type="radio" name="tiptra" id="f-tiptra-jornal" value="J" />
                <span class="checkmark" style="border-radius: 50%;"></span>
                JORNAL
              </label>
            </div>
          </div>

          <!-- UBICACIÓN -->
          <div class="field">
            <label for="f-ubicod">UBICACIÓN *</label>
            <select id="f-ubicod" class="input" style="height: 48px; padding: 10px 14px;" required>
              <option value="">SELECCIONE UBICACIÓN</option>
            </select>
          </div>

          <!-- DETALLES DE LA UBICACIÓN -->
          <div class="form-grid-2-local">
            <div class="field">
              <label>TIPO DE UBICACIÓN</label>
              <input id="lbl-ubiuni" class="input" readonly style="background: var(--surface-100);" value="---" />
            </div>
            <div class="field">
              <label id="lbl-unidad-lbl">CANTIDAD / VALOR</label>
              <input id="lbl-valores" class="input" readonly style="background: var(--surface-100);" value="---" />
            </div>
          </div>

          <!-- LOTE -->
          <div class="field" id="loteFieldGroup">
            <label for="f-lote">LOTE *</label>
            <div style="display: grid; grid-template-columns: 1fr auto; gap: var(--s2); align-items: center;">
              <select id="f-lote" class="input" style="height: 48px; padding: 10px 14px;">
                <option value="">SELECCIONE LOTE</option>
              </select>
              <span id="lbl-lote-progress" class="badge" style="font-weight: 800; background: var(--brand-100); color: var(--brand-900); padding: 8px 12px; border-radius: 8px;">---</span>
            </div>
          </div>

          <!-- CANTIDADES A INGRESAR -->
          <div class="form-grid-2-local">
            <div class="field">
              <label for="f-cantidadIngresar">CANT. A INGRESAR *</label>
              <div style="display: flex; align-items: center; position: relative;">
                <input type="number" id="f-cantidadIngresar" class="input" placeholder="0" min="0" required style="width: 100%;" />
                <span id="f-cant-lbl-badge" style="position: absolute; right: 12px; color: var(--muted); font-size: 0.75rem; font-weight: 700;">---</span>
              </div>
            </div>
            <div class="field" id="vuFieldGroup">
              <label for="f-vuIngresar">VU A INGRESAR *</label>
              <div style="display: flex; align-items: center; position: relative;">
                <input type="number" id="f-vuIngresar" class="input" placeholder="0.00" min="0" step="0.01" required style="width: 100%;" />
                <span id="f-vu-lbl-badge" style="position: absolute; right: 12px; color: var(--muted); font-size: 0.75rem; font-weight: 700;">---</span>
              </div>
            </div>
          </div>

        </form>
      </div>
    </div>

    <!-- COLUMNA DERECHA: TABLA DE OPERARIOS Y BOTONERA -->
    <div class="card" style="box-shadow: var(--shadow-md); display: flex; flex-direction: column;">
      <div class="card__head" style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;">
        <h3 class="card__title">Operarios Asignados</h3>
        <button type="button" class="btn btn--brand" id="btnAgregarOperario" disabled>Agregar Operarios</button>
      </div>
      <div class="card__body" style="padding: var(--s3); display: flex; flex-direction: column; gap: var(--s3); flex: 1;">
        
        <!-- TABLA DE OPERARIOS -->
        <div class="table-clip" style="border: 1px solid var(--border-200); border-radius: 12px; overflow-y: auto; max-height: 480px; flex: 1;">
          <table class="table table--grid" id="operariosTable" style="table-layout: auto; width: 100%;">
            <thead>
              <tr>
                <th style="width: 75px; text-align: left; padding: 10px 6px;">CÓDIGO</th>
                <th style="min-width: 140px; text-align: left; padding: 10px 6px;">NOMBRE</th>
                <th style="width: 75px; text-align: center; padding: 10px 4px;">CANT. (#)</th>
                <th style="width: 85px; text-align: center; padding: 10px 4px;">VU</th>
                <th style="width: 65px; text-align: center; padding: 10px 4px;">ACC.</th>
              </tr>
            </thead>
            <tbody id="operarios-tbody">
              <tr class="row-empty"><td colspan="5">Ningún operario seleccionado. Utilice el botón "AGREGAR" de arriba.</td></tr>
            </tbody>
          </table>
        </div>

        <!-- AREA DE MENSAJES / ALERTAS -->
        <div id="alertArea" class="status-alert" style="display: none; padding: 14px var(--s3); border-radius: 12px; font-weight: 700; font-size: 0.95rem; text-align: center; text-transform: uppercase;"></div>

        <!-- BOTONERA INFERIOR -->
        <div style="display: flex; justify-content: flex-end; gap: var(--s3); border-top: 1px solid var(--border-200); padding-top: var(--s3); margin-top: auto;">
          <button class="btn btn-soft" id="btnCancel">CANCELAR</button>
          <button class="btn btn--brand" id="btnAccept" style="min-width: 140px;">ACEPTAR</button>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- ==========================================
     MODAL DE SELECCIÓN DE ORDEN DE TRABAJO (OT)
     ========================================== -->
<div class="modal" id="modalOt">
  <div class="modal-dialog" style="max-width: 850px;">
    <div class="modal-content">
      <div class="modal-header">
        <h3>Seleccionar Orden de Trabajo</h3>
        <button type="button" class="modal-close" id="btnCloseModalOt">&times;</button>
      </div>
      <div class="modal-body">
        <div class="field" style="margin-bottom: var(--s3);">
          <input type="text" id="modalOtSearch" class="input input--upper" placeholder="BUSCAR POR OT, CLIENTE O PRODUCTO..." autocomplete="off" />
          <p class="hint" style="margin-top: 4px;">Ingrese al menos 3 caracteres para buscar.</p>
        </div>
        <div class="table-clip" style="border: 1px solid var(--border-200); border-radius: 12px; max-height: 300px; overflow-y: auto;">
          <table class="table table--grid">
            <thead>
              <tr>
                <th style="width: 120px;">OT</th>
                <th>Cliente</th>
                <th style="width: 100px;">OV</th>
                <th style="width: 120px;">Producto</th>
                <th>Descripción</th>
                <th style="width: 80px; text-align: center;">Cant.</th>
              </tr>
            </thead>
            <tbody id="modalOtTbody">
              <tr class="row-empty"><td colspan="6">Ingrese un término de búsqueda para ver OTs.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ==========================================
     MODAL DE SELECCIÓN DE OPERARIOS
     ========================================== -->
<div class="modal" id="modalOperario">
  <div class="modal-dialog" style="max-width: 650px;">
    <div class="modal-content">
      <div class="modal-header">
        <h3 id="modalOperarioTitle">Asignar Operarios</h3>
        <button type="button" class="modal-close" id="btnCloseModalOp">&times;</button>
      </div>
      <div class="modal-body" style="display: flex; flex-direction: column; gap: var(--s3);">
        <input type="text" id="modalOpSearch" class="input" placeholder="BUSCAR POR NOMBRE O CÓDIGO..." autocomplete="off" />
        
        <div class="table-clip" style="border: 1px solid var(--border-200); border-radius: 12px; max-height: 250px; overflow-y: auto;">
          <table class="table table--grid">
            <thead>
              <tr>
                <th style="width: 40px; text-align: center;">Sel.</th>
                <th style="width: 100px;">Código</th>
                <th>Nombre y Apellido</th>
                <th>Cargo</th>
              </tr>
            </thead>
            <tbody id="modalOpTbody">
              <tr class="row-empty"><td colspan="4">Cargando operarios...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-soft" id="btnCancelOp">Cerrar</button>
        <button type="button" class="btn btn--brand" id="btnAcceptOp">Agregar Seleccionados</button>
      </div>
    </div>
  </div>
</div>

<!-- ESTILOS LOCALES COMPLEMENTARIOS Y GRID RESPONSIVO -->
<style>
.produccion-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--s4);
  align-items: stretch;
  width: 100%;
}

@media (min-width: 992px) {
  .produccion-grid {
    grid-template-columns: 1fr 1fr; /* 50/50 balanceado */
  }
}

/* Layout superior de OT y Producto */
.ot-header-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--s3);
  align-items: center;
}
@media (min-width: 992px) {
  .ot-header-layout {
    grid-template-columns: 300px 1fr;
  }
}

.info-block-horizontal {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--s2);
  background: var(--surface-100);
  border: 1px solid var(--border-200);
  border-radius: 12px;
  padding: 14px 20px;
}
@media (min-width: 768px) {
  .info-block-horizontal {
    grid-template-columns: auto 1fr auto;
    gap: var(--s4);
  }
  .info-block-horizontal .info-cell.separator {
    border-left: 1px solid var(--border-300);
    padding-left: var(--s4);
  }
}

.info-cell {
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.info-cell-lbl {
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--muted);
  text-transform: uppercase;
  margin-bottom: 4px;
}
.info-cell-val {
  font-size: 0.95rem;
  font-weight: 800;
  color: var(--brand-900);
  word-break: break-word;
}
.text-right {
  text-align: right;
}
@media (max-width: 767px) {
  .text-right {
    text-align: left;
  }
  .info-block-horizontal .info-cell:not(:first-child) {
    border-top: 1px dashed var(--border-200);
    padding-top: var(--s2);
  }
}

/* Rejilla local de 2 columnas sin min-width restrictivo en celdas */
.form-grid-2-local {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  min-width: 0;
  width: 100%;
}
.form-grid-2-local .field {
  margin-bottom: 0;
  min-width: 0;
}

@media (max-width: 480px) {
  .form-grid-2-local {
    grid-template-columns: 1fr;
    gap: var(--s2);
  }
}

.info-grid-row {
  display: flex;
  justify-content: space-between;
  padding: 6px 0;
  font-size: 0.9rem;
}
.info-grid-row:not(:last-child) {
  border-bottom: 1px dashed var(--border-200);
}
.info-grid-lbl {
  font-weight: 700;
  color: var(--text-700);
}
.info-grid-val {
  font-weight: 800;
  color: var(--brand-900);
  text-align: right;
  max-width: 70%;
  word-break: break-all;
}
.status-alert {
  transition: all 0.3s ease;
}
.status-alert.alert-success {
  background-color: #eff6ff;
  border: 1px solid var(--brand-300);
  color: var(--brand-700);
}
.status-alert.alert-error {
  background-color: #fef2f2;
  border: 1px solid #fca5a5;
  color: #b91c1c;
}
.status-alert.alert-warning {
  background-color: #fffbeb;
  border: 1px solid #fde68a;
  color: #b45309;
}
.badge {
  font-size: 0.8rem;
  font-weight: 700;
}
</style>

<%- include('partials/footer') %>
